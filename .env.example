# Copier dans .env et compléter uniquement pour Shopify réel.
DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY="e6b465322485bff1f48e5d06656d49a6"
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://votre-domaine"
SCOPES="read_products,read_customers,write_draft_orders"
# APP_DEMO_MODE doit être absent en production.

# --- Outil pro autonome (hors admin Shopify) ---
# APP_MODE=standalone
# Domaine *.myshopify.com de la boutique (jeton serveur par client credentials).
# SHOPIFY_SHOP=
# Secret aléatoire de 32 caractères ou plus pour les sessions.
# SESSION_SECRET=
