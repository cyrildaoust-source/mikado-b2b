// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Neon : connexion directe pour les migrations (nom fourni par l'intégration Vercel).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Quote {
  id          Int       @id @default(autoincrement())
  shop        String
  number      String?   @unique
  title       String
  customer    String
  state       String
  version     Int       @default(1)
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revisions   Revision[]
  conversion  Conversion?
  billingRequests BillingRequest[]
  ownerId     Int?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  moodBoard   MoodBoard?
  moodImages  MoodImage[]
  shares      QuoteShare[]
  decisions   QuoteDecision[]
  @@index([shop, updatedAt])
  @@index([ownerId])
}

model Revision {
  id        Int      @id @default(autoincrement())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version   Int
  state     String
  createdAt DateTime @default(now())
  pdf       Bytes?
  publishedNumber Int?
  issuedAt DateTime?
  sentAt DateTime?
  calculation String?
  documentMeta String?
  pdfGeneratedAt DateTime?
  shares QuoteShare[]
  decisions QuoteDecision[]
  @@unique([quoteId, version])
  @@unique([quoteId, publishedNumber])
}

model Conversion {
  id          String   @id @default(cuid())
  quoteId     Int      @unique
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version     Int
  status      String   @default("preview")
  preview     String
  draftId     String?
  draftName   String?
  orderId String?
  orderName String?
  orderStatus String?
  acceptedAt DateTime?
  error       String?
  updatedAt   DateTime @updatedAt
}

model QuoteCounter {
 shop String
 year Int
 value Int @default(0)
 @@id([shop, year])
}

model BillingRequest {
  id String @id @default(cuid())
  quoteId Int
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  kind String
  amount Int
  netAmount Int?
  taxAmount Int?
  currency String @default("EUR")
  status String @default("queued")
  invoiceId Int?
  invoiceNumber String?
  invoiceState String?
  paymentState String?
  residual Int?
  partnerId Int?
  authorizedBy String?
  authorizedAt DateTime @default(now())
  milestoneConfirmedAt DateTime?
  error String?
  syncedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([quoteId, kind])
  @@index([status, updatedAt])
}

// Accès autonome (outil pro hors admin Shopify).
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  role         String    @default("architect")
  passwordHash String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  quotes       Quote[]
  invites      Invite[]
  // Classe choisie par Mikado Deco : un minimum, le chiffre peut la dépasser.
  classId      Int?
  class        ArchitectClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  firm         FirmProfile?
}

// Fiche du cabinet de l'architecte : l'identité de ses propositions client.
model FirmProfile {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  address   String   @default("")
  vat       String   @default("")
  phone     String   @default("")
  email     String   @default("")
  website   String   @default("")
  logoMime  String?
  logo      Bytes?
  updatedAt DateTime @updatedAt
}

// Classe d'architecte : une remise et le chiffre annuel qui l'ouvre.
model ArchitectClass {
  id        Int      @id @default(autoincrement())
  name      String
  // Remise accordée, en pour cent (10 = 10 %).
  discount  Float
  // Devis acceptés HTVA sur 12 mois glissants, en centimes, pour y entrer.
  threshold Int      @default(0)
  createdAt DateTime @default(now())
  users     User[]
}

model Invite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Réglage par marque du catalogue pro, tenu par Cyril.
model BrandSetting {
  vendor    String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Mood board d'un devis : planches par pièce (JSON, voir app/domain/moodboard.ts).
// À part du devis : le modifier ne crée ni version ni révision.
model MoodBoard {
  quoteId   Int      @id
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  state     String
  updatedAt DateTime @updatedAt
}

// Photo ajoutée par l'architecte (inspiration, matière, plan). Redimensionnée
// dans le navigateur avant l'envoi.
model MoodImage {
  id        String   @id @default(cuid())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  width     Int
  height    Int
  name      String   @default("")
  createdAt DateTime @default(now())
  @@index([quoteId])
}

// Bibliothèque de matières de Mikado Deco (tissus Kvadrat en magasin…),
// tenue par Cyril, proposée à tous les architectes dans le mood board.
model LibraryMaterial {
  id         String   @id @default(cuid())
  maker      String
  collection String
  colour     String   @default("")
  mime       String
  data       Bytes?
  /// Photo servie depuis le site de l'éditeur (cdn.dedar.com) au lieu d'être copiée.
  remote     String?
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  @@index([maker, collection])
}

/// Lien secret vers une révision figée d'un devis. Seule l'empreinte SHA-256
/// du jeton est conservée : le lien complet n'est montré qu'à sa création.
model QuoteShare {
  id            Int       @id @default(autoincrement())
  quoteId       Int
  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId    Int
  revision      Revision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  createdById   Int?
  expiresAt     DateTime
  revokedAt     DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  views         Int       @default(0)
  @@index([quoteId])
}

/// Acceptation du client sur la proposition en ligne, puis contresignature de
/// l'architecte et suivi de facturation par Mikado Deco. La première décision
/// l'emporte : elle fait passer le devis de draft à accepted en une écriture
/// conditionnelle. Une décision rouverte reste en historique.
model QuoteDecision {
  id                Int       @id @default(autoincrement())
  quoteId           Int
  quote             Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId        Int
  revision          Revision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  shareId           Int?
  /// accepted : le client a signé ; signed : l'architecte a contresigné, à
  /// facturer ; invoiced : facturé par Mikado ; reopened : l'architecte révise.
  status            String    @default("accepted")
  choices           String
  remark            String    @default("")
  clientFirstName   String
  clientLastName    String
  acceptedAt        DateTime  @default(now())
  acceptedIp        String    @default("")
  acceptedAgent     String    @default("")
  /// Montants du client, recalculés côté serveur sur la révision figée (centimes).
  net               Int
  tax               Int
  gross             Int
  deadline          DateTime
  architectName     String?
  architectUserId   Int?
  architectSignedAt DateTime?
  /// Montant facturé par Mikado à l'architecte, figé à la contresignature (JSON).
  billing           String?
  remindedAt        DateTime?
  dueDate           DateTime?
  invoicedAt        DateTime?
  invoicedById      Int?
  reopenedAt        DateTime?
  @@index([quoteId])
  @@index([status])
}
