// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Neon : connexion directe pour les migrations (nom fourni par l'intégration Vercel).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Quote {
  id          Int       @id @default(autoincrement())
  shop        String
  number      String?   @unique
  title       String
  customer    String
  state       String
  version     Int       @default(1)
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revisions   Revision[]
  conversion  Conversion?
  billingRequests BillingRequest[]
  ownerId     Int?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  moodBoard   MoodBoard?
  moodImages  MoodImage[]
  @@index([shop, updatedAt])
  @@index([ownerId])
}

model Revision {
  id        Int      @id @default(autoincrement())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version   Int
  state     String
  createdAt DateTime @default(now())
  pdf       Bytes?
  publishedNumber Int?
  issuedAt DateTime?
  sentAt DateTime?
  calculation String?
  documentMeta String?
  pdfGeneratedAt DateTime?
  @@unique([quoteId, version])
  @@unique([quoteId, publishedNumber])
}

model Conversion {
  id          String   @id @default(cuid())
  quoteId     Int      @unique
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version     Int
  status      String   @default("preview")
  preview     String
  draftId     String?
  draftName   String?
  orderId String?
  orderName String?
  orderStatus String?
  acceptedAt DateTime?
  error       String?
  updatedAt   DateTime @updatedAt
}

model QuoteCounter {
 shop String
 year Int
 value Int @default(0)
 @@id([shop, year])
}

model BillingRequest {
  id String @id @default(cuid())
  quoteId Int
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  kind String
  amount Int
  netAmount Int?
  taxAmount Int?
  currency String @default("EUR")
  status String @default("queued")
  invoiceId Int?
  invoiceNumber String?
  invoiceState String?
  paymentState String?
  residual Int?
  partnerId Int?
  authorizedBy String?
  authorizedAt DateTime @default(now())
  milestoneConfirmedAt DateTime?
  error String?
  syncedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([quoteId, kind])
  @@index([status, updatedAt])
}

// Accès autonome (outil pro hors admin Shopify).
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  role         String    @default("architect")
  passwordHash String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  quotes       Quote[]
  invites      Invite[]
}

model Invite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Réglage par marque du catalogue pro, tenu par Cyril.
model BrandSetting {
  vendor    String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Mood board d'un devis : planches par pièce (JSON, voir app/domain/moodboard.ts).
// À part du devis : le modifier ne crée ni version ni révision.
model MoodBoard {
  quoteId   Int      @id
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  state     String
  updatedAt DateTime @updatedAt
}

// Photo ajoutée par l'architecte (inspiration, matière, plan). Redimensionnée
// dans le navigateur avant l'envoi.
model MoodImage {
  id        String   @id @default(cuid())
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  width     Int
  height    Int
  name      String   @default("")
  createdAt DateTime @default(now())
  @@index([quoteId])
}
