{
  "name": "mikado-devis",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "tsc --noEmit",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "dev:local": "APP_DEMO_MODE=true SHOPIFY_API_KEY=local-preview SHOPIFY_API_SECRET=local-preview SHOPIFY_APP_URL=http://localhost:3000 vite --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "odoo:check": "node scripts/check-odoo-connection.mjs",
    "format": "prettier --write app tests scripts",
    "predev:local": "npm run setup",
    "user:invite": "tsx scripts/invite-user.ts",
    "vercel-build": "bash scripts/vercel-build.sh",
    "postinstall": "prisma generate"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "@sparticuz/chromium": "^143.0.4",
    "@vercel/react-router": "^1.3.7",
    "isbot": "^5.1.31",
    "playwright": "^1.58.2",
    "pptxgenjs": "4.0.1",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "sharp": "0.35.5",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
